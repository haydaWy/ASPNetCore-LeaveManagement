@model HR.LeaveManagement.MVC.Models.CreateLeaveTypeVM

@{
    ViewData["Title"] = "Create";
}

<div class="container mt-2">
    <div class="row">
        <div class="col-md-8 col-lg-6">

            <h2 class="mb-0">Create</h2>
            <h6 class="border-bottom pb-2 mb-3">
                CreateLeaveTypeVM
            </h6>

            <form asp-action="Create" method="post">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger small">
                </div>

                <div class="form-group mb-2">
                    <label asp-for="Name"
                           class="form-label small mb-1"></label>

                    <input asp-for="Name"
                           class="form-control form-control-sm" />

                    <span asp-validation-for="Name"
                          class="text-danger small">
                    </span>
                </div>

                <div class="form-group mb-2">
                    <label asp-for="DefaultDays"
                           class="form-label small mb-1"></label>

                    <input asp-for="DefaultDays"
                           class="form-control form-control-sm" />

                    <span asp-validation-for="DefaultDays"
                          class="text-danger small">
                    </span>
                </div>

                <button type="submit"
                        class="btn btn-primary btn-sm">
                    Create
                </button>

            </form>

            <div class="mt-2">
                <a asp-action="Index" class="small">
                    Back to List
                </a>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}